<?xml version="1.0"?>
<failureSpec>

    <!--
      Time-based, phase-driven fault specification.
      Replica IDs are global IDs (0..N-1).

      Network precedence per phase: edge > source > global.
      Network delay semantics:
        - <globalNetworkDelay>/<delayMs> is a constant base one-way packet delay.
        - Per-phase network <delayMs> is an extra delay during slow bursts.
        - Per-phase network <baselineDelayMs> is an optional extra delay held
          for the whole phase, under the burst. Defaults to 0.
        - <burstStartOffsetMs> pins every burst to a fixed offset inside its
          interval, the same for every directed edge. Omit it for the default
          deterministic-random placement, which is drawn per edge and so
          staggers the links against each other.
        - <burstDurationMs> and <burstIntervalMs> define burst scheduling:
          one slow burst is placed at a deterministic-random start time within
          each interval fully contained in the phase.
        - During a burst: delay = globalNetworkDelay + phase delayMs.
          Outside bursts: delay = globalNetworkDelay + phase baselineDelayMs.
        - Set both burst fields to 0 to disable phase network bursts.
          If burstDurationMs >= burstIntervalMs, the edge is continuously slow.
      Protocol precedence per phase: replica override > global default.
      Proposal delay:
        - <interval> repeats the proposal-delay phase every N seconds until the
          next phase starts. <intervalMs> can be used for millisecond precision.
        - For <id>leader</id>, the leader is resolved independently at each
          interval tick.

      Phase timing:
        - Preferred: <atTime> means "activate this phase at t seconds from start".
        - Legacy: <time> is interpreted as phase duration by the network applier.
    -->

    <!--
      VARIANT: the fault is invisible at decision time.

      Differs from failure_spec.xml only in the three network-delay phases
      (p3, p4, p5), which burst in lockstep on a 20s cycle aligned to the
      learning agent's episode:

        agent episode   feature 10s | reply 2s | warmup 3s | reward 5s = 20s
        this spec       quiet 0-15s                        | burst 15-20s

      <burstStartOffsetMs>15000</burstStartOffsetMs> with a 5s burst in a 20s
      interval puts the delay exactly over the reward window and nowhere else.
      <baselineDelayMs> is 0 on purpose: the feature window has to read clean.

      What it is for. Every earlier attempt at making these phases harder left
      the fault visible in the feature window, and a rule of the form
      timeout = k * latency then absorbs it - the reading is off by a roughly
      constant factor, so some k corrects it, and the experiment measures
      tuning rather than structure. Aligning the burst to the reward window
      removes the identifiability instead: a fault phase and a base phase both
      report ~52ms in the feature window and need different timeouts, and no
      function of the measurement can return two answers for one input. The
      rule sits at its 300ms clamp floor in every phase; a policy that also
      learns from the reward window still sees the cost.

      Be honest about what this does NOT test. The latency floor reads the same
      feature window, so it stays near 52ms and never binds - this spec cannot
      show the floor helping. And because the fault phases are indistinguishable
      from the base phases in the feature vector, a learner can only track them
      by recency, not recognise them by context. The claim it supports is
      "learning from outcomes beats measuring inputs when the fault is not
      observable at decision time", nothing narrower.

      Calibrate before comparing. The applier and the agent both anchor to
      START_UNIX_MS, but the agent has its own warm-up, so a constant skew
      between episode boundaries and burst intervals is possible. If the offset
      is wrong the burst lands in the feature window and the design inverts.
      Check the first run's agent CSV timestamps against the applier log's
      burst start/end lines before spending a comparison set.

      Everything else - phase times, delay magnitudes, proposal delays,
      warm-up, base phases - is unchanged from failure_spec.xml.
    -->

    <schemaVersion>4</schemaVersion>
    <replicaIdType>global</replicaIdType>
    <!-- Warm-up period in seconds: no failure behavior is active during this time. -->
    <warmUpTime>10</warmUpTime>

    <!-- Constant one-way packet delay applied for the whole experiment. -->
    <globalNetworkDelay>
        <delayMs>5</delayMs>
    </globalNetworkDelay>

    <phases>
        <!-- Base case -->
        <phase>
            <!-- Activate this phase at t=0 seconds from experiment start -->
            <atTime>0</atTime>

            <network>
                <directedEdges>true</directedEdges>
                <precedence>global,source,edge</precedence>

                <!-- Extra burst delay applied to all directed edges unless overridden -->
                <global>
                    <delayMs>0</delayMs>
                    <burstDurationMs>0</burstDurationMs>
                    <burstIntervalMs>0</burstIntervalMs>
                </global>

                <!-- Extra burst delay applied to all outgoing edges from src unless overridden by edge -->
                <sources>
                    <!--
                    <source>
                        <src>0</src>
                        <delayMs>0</delayMs>
                        <burstDurationMs>0</burstDurationMs>
                        <burstIntervalMs>0</burstIntervalMs>
                    </source>
                    -->
                </sources>

                <!-- Extra burst delay applied to one directed edge (src -> dst) -->
                <edges>
                    <!--
                    <edge>
                        <src>0</src>
                        <dst>1</dst>
                        <delayMs>0</delayMs>
                        <burstDurationMs>0</burstDurationMs>
                        <burstIntervalMs>0</burstIntervalMs>
                    </edge>
                    -->
                </edges>
            </network>

            <pbft>
                <!--
                  Proposal-delay behavior:
                    enabled for listed replica IDs.
                    Special ID "leader" means:
                    snapshot the active phase or interval-tick leader and target
                    leader + next (f-1) replicas in current view order.
                -->
                <proposalDelay>
                    <replicas>
                        <!--
                        <replica>
                            <id>leader</id>
                            <delayMs>300</delayMs>
                        </replica>
                        -->
                    </replicas>
                </proposalDelay>
            </pbft>

            <agent>
                <!--
                  Dirty report behavior:
                    random dirty report is enabled only for listed replica IDs.
                    If a replica ID is not listed, dirty report is disabled.
                -->
                <dirtyReport>
                    <replicas>
                        <!--
                        <id>2</id>
                        -->
                    </replicas>
                </dirtyReport>

                <!--
                  Ignore-report behavior:
                    submit exactly 2f+1 reports even if more were collected.
                    Enabled only for listed replica IDs.
                -->
                <ignoreReport>
                    <replicas>
                        <!--
                        <id>3</id>
                        -->
                    </replicas>
                </ignoreReport>
            </agent>
        </phase>

        <phase>
            <atTime>300</atTime>
            <network>
                <directedEdges>true</directedEdges>
                <precedence>global,source,edge</precedence>

                <global>
                    <delayMs>0</delayMs>
                    <burstDurationMs>0</burstDurationMs>
                    <burstIntervalMs>0</burstIntervalMs>
                </global>
            </network>

            <pbft>
                <proposalDelay>
                    <interval>60</interval>
                    <replicas>
                        <replica>
                            <id>leader</id>
                            <delayMs>300</delayMs>
                        </replica>
                    </replicas>
                </proposalDelay>
            </pbft>
        </phase>

        <phase>
            <atTime>600</atTime>
            <network>
                <directedEdges>true</directedEdges>
                <precedence>global,source,edge</precedence>

                <global>
                    <delayMs>0</delayMs>
                    <burstDurationMs>0</burstDurationMs>
                    <burstIntervalMs>0</burstIntervalMs>
                </global>
            </network>

            <pbft>
                <proposalDelay>
                    <interval>60</interval>
                    <replicas>
                        <replica>
                            <id>leader</id>
                            <delayMs>600</delayMs>
                        </replica>
                    </replicas>
                </proposalDelay>
            </pbft>
        </phase>

        <!-- Small network delay -->
        <phase>
            <atTime>900</atTime>
            <network>
                <directedEdges>true</directedEdges>
                <precedence>global,source,edge</precedence>

                <global>
                    <baselineDelayMs>0</baselineDelayMs>
                    <delayMs>50</delayMs>
                    <burstDurationMs>5000</burstDurationMs>
                    <burstIntervalMs>20000</burstIntervalMs>
                    <burstStartOffsetMs>15000</burstStartOffsetMs>
                </global>
            </network>
        </phase>

        <phase>
            <atTime>1200</atTime>
            <network>
                <directedEdges>true</directedEdges>
                <precedence>global,source,edge</precedence>

                <global>
                    <baselineDelayMs>0</baselineDelayMs>
                    <delayMs>50</delayMs>
                    <burstDurationMs>5000</burstDurationMs>
                    <burstIntervalMs>20000</burstIntervalMs>
                    <burstStartOffsetMs>15000</burstStartOffsetMs>
                </global>
            </network>

            <pbft>
                <proposalDelay>
                    <interval>60</interval>
                    <replicas>
                        <replica>
                            <id>leader</id>
                            <delayMs>300</delayMs>
                        </replica>
                    </replicas>
                </proposalDelay>
            </pbft>
        </phase>

        <!-- Large network delay -->
        <phase>
            <atTime>1500</atTime>
            <network>
                <directedEdges>true</directedEdges>
                <precedence>global,source,edge</precedence>

                <global>
                    <baselineDelayMs>0</baselineDelayMs>
                    <delayMs>150</delayMs>
                    <burstDurationMs>5000</burstDurationMs>
                    <burstIntervalMs>20000</burstIntervalMs>
                    <burstStartOffsetMs>15000</burstStartOffsetMs>
                </global>
            </network>
        </phase>

        <phase>
            <atTime>1800</atTime>
            <network>
                <directedEdges>true</directedEdges>
                <precedence>global,source,edge</precedence>

                <global>
                    <delayMs>0</delayMs>
                    <burstDurationMs>0</burstDurationMs>
                    <burstIntervalMs>0</burstIntervalMs>
                </global>
            </network>
        </phase>
    </phases>
</failureSpec>
